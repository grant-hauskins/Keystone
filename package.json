{
  "name": "keystone-context",
  "version": "0.1.0",
  "private": true,
  "description": "Plain-English audits and context for agent code changes",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsc && node build/tui.js",
    "tui": "tsc && node build/tui.js",
    "build": "tsc && tsc -p tsconfig.action.json",
    "check": "tsc --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test build/tests/test/*.test.js",
    "keystone": "tsc && node build/cli.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  }
}
